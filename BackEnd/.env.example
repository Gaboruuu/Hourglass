# Copy to .env (gitignored) and fill in. On Render, set the same names as environment variables.

# --- Database (Aiven MySQL) ---
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=change-me
DB_NAME=defaultdb
DB_SSL=REQUIRED
# Aiven CA certificate (Aiven console → service → Overview → "CA certificate").
# Render: add it as a Secret File named aiven-ca.pem → /etc/secrets/aiven-ca.pem
DB_CA_PATH=./aiven-ca.pem

# --- Auth ---
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
# Admin session length (default 12h)
JWT_EXPIRATION=12h
# Sync API keys, comma-separated (two only while rotating). Empty = EventsSync can't write.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SYNC_API_KEYS=
# false = report-only (rejections are logged, not enforced). Only for the rollout; anything else enforces.
AUTH_ENFORCE=true

# --- HTTP ---
# Browser origins allowed by CORS (the future web version), comma-separated. Empty = none.
CORS_ORIGINS=
PORT=8080
